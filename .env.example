# ===================================================================
# MediaFetch - Environment Configuration & Security Settings
# ===================================================================

# Telegram Bot Token obtained from @BotFather on Telegram (Required to run live Telegram bot)
# Example: BOT_TOKEN="7123456789:AAHk...exampleToken"
BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN_HERE"

# Telegram Bot API Server endpoint (Optional)
# Default: "https://api.telegram.org" (Telegram Public Cloud API - 50MB bot upload limit)
# For up to 2,000 MB (2 GB) uploads: Run Telegram Local Bot API server (telegram-bot-api) and set:
# TELEGRAM_API_ROOT="http://localhost:8081"
TELEGRAM_API_ROOT="https://api.telegram.org"

# Port for the web interface and API server (Default: 3000)
PORT=3000

# Admin Authentication Credentials (Required to manage live bot and view server logs)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="ChangeThisStrongPassword2026!"

# Custom path to yt-dlp executable (optional; leave blank to use auto-detected bundled or system binary)
# Windows example: YT_DLP_PATH="C:\\yt-dlp\\yt-dlp.exe"
# Linux example: YT_DLP_PATH="./bin/yt-dlp"
YT_DLP_PATH=""

# Custom path to ffmpeg executable (optional; leave blank if ffmpeg is in your system PATH)
# Windows example: FFMPEG_PATH="C:\\ffmpeg\\bin\\ffmpeg.exe"
FFMPEG_PATH=""
